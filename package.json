{
  "name": "poster-valley-kickoff-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test",
    "test:schema-baseline": "node scripts/database/verify-schema-baseline.mjs",
    "test:staging-fixtures": "node --test test/clean-staging-fixtures.test.js",
    "staging:seed": "node scripts/staging/seed-clean-staging.mjs",
    "staging:verify": "node scripts/staging/verify-clean-staging.mjs",
    "staging:cleanup": "node scripts/staging/cleanup-clean-staging.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "playwright:install:chromium": "playwright install chromium",
    "supabase": "supabase",
    "preview": "vite preview",
    "preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tooling/preflight.ps1",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tooling/verify.ps1",
    "check:versions": "node scripts/tooling/tool-versions.mjs",
    "check:diff-local": "node scripts/tooling/git-diff-check.mjs --local",
    "check:repository": "node scripts/tooling/repository-checks.mjs all",
    "check:text": "node scripts/tooling/repository-checks.mjs text",
    "check:secrets": "node scripts/tooling/repository-checks.mjs secrets",
    "check:function-budget": "node scripts/tooling/repository-checks.mjs function-budget",
    "check:governance": "node scripts/tooling/governance-checks.mjs",
    "env:audit": "node scripts/tooling/environment-key-audit.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.100.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "supabase": "2.111.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
